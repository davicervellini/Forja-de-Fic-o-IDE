# ============================================================
# Forja de Ficção — Configuração
# ============================================================
# Edite os valores abaixo sem tocar no código Python.
# O programa lê este arquivo ao iniciar. Um valor definido aqui
# vale mais que o padrão do pipeline/config.py; apague a linha
# para voltar ao padrão. O que for salvo pela tela ⚙ Configurações
# (config.json) vale mais que este arquivo.
# ============================================================

# --- Servidor Ollama ---
# 127.0.0.1 em vez de localhost: no Windows, localhost tenta IPv6 antes e cada chamada perde 2 s.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Provedores ---
# ollama (local) ou nuvem: anthropic, google, openai, openai_compat.
# As chaves de API NÃO vão aqui (este arquivo vai para o git): cadastre em
# ⚙ Configurações, que grava em credenciais.json na pasta de dados do usuário.
PROVIDER_DRAFTING=ollama
PROVIDER_REFINING=ollama
PROVIDER_SUMMARIZING=ollama

# --- Modelos ---
# Fase 1 (Rascunho): escreve o capítulo a partir da premissa
MODEL_DRAFTING=llama3.1:8b
# Fase 2 (Polimento): corrige fluência e grafias sem mudar o que acontece
MODEL_REFINING=gemma3:12b
# Fase 3 (Resumo, memória, fusão e checagem de consistência)
MODEL_SUMMARIZING=llama3.1:8b

# --- Fase 1: Rascunho ---
DRAFTING_TEMPERATURE=0.7
# Contexto em tokens. 8192 não cabe um capítulo de 2.500 palavras
# a partir do capítulo 2 ou 3: o Ollama descarta o começo do prompt
# em silêncio, e é lá que fica o Registro Akáshico.
DRAFTING_NUM_CTX=12288

# --- Fase 2: Polimento ---
# Temperatura baixa: polir, não reescrever.
REFINING_TEMPERATURE=0.4
REFINING_NUM_CTX=10240

# --- Fase 3: Resumo e memória ---
SUMMARIZING_TEMPERATURE=0.2
SUMMARIZING_NUM_CTX=8192

# --- Camadas na GPU (opcional) ---
# Vazio = automático. Se aparecer erro de memória de vídeo, defina
# um número menor de camadas para o modelo que falhou.
DRAFTING_NUM_GPU=
REFINING_NUM_GPU=
SUMMARIZING_NUM_GPU=

# --- Geração cena por cena ---
# Modelos pequenos não escrevem 2.000 palavras de uma vez; o capítulo
# é escrito e polido uma cena por vez.
CHAPTER_TARGET_WORDS=2200
# Cena abaixo de 60% da meta ganha até 2 pedidos de continuação.
SCENE_MIN_RATIO=0.6
SCENE_MAX_CONTINUATIONS=2
SCENE_BREAK=* * *
DRAFTING_REPEAT_PENALTY=1.15
# Janela da penalidade de repetição em tokens (o padrão do Ollama, 64, não pega frases repetidas).
DRAFTING_REPEAT_LAST_N=1024
PREVIOUS_CHAPTER_TAIL_WORDS=350
CHAPTER_SO_FAR_TAIL_WORDS=700
# Polimento que encolher a cena abaixo de 70% é descartado (fica salvo em polimento_descartado.md).
REFINE_MIN_RATIO=0.7

# --- Continuidade ---
# Resumos completos mantidos no prompt; os mais antigos viram
# a "história até agora".
RECENT_SUMMARIES_KEPT=4
SUMMARY_MAX_WORDS=250
STORY_SO_FAR_MAX_WORDS=700
DYNAMIC_MEMORY_MAX_WORDS=600
CONSISTENCY_CHECK_ENABLED=true

# --- Timeout (segundos) ---
# Tempo máximo esperando o próximo pedaço de texto do Ollama.
# Generoso para acomodar a troca de modelos na memória de vídeo.
REQUEST_TIMEOUT=3600
