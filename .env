# ============================================================
# Pipeline de Ficção — Configuração
# ============================================================
# Edite os valores abaixo sem tocar no código Python.
# O script lê este arquivo automaticamente na inicialização.
# ============================================================

# --- Servidor Ollama ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Modelos ---
# Fase 1 (Rascunho): modelo focado em instrução/lógica
MODEL_DRAFTING=llama3.1:8b
# Fase 2 (Polimento): modelo focado em prosa rica/literária
MODEL_REFINING=gemma3:12b
# Fase 3 (Resumo de Continuidade): modelo para extrair resumo
MODEL_SUMMARIZING=llama3.1:8b

# --- Hiperparâmetros: Fase 1 ---
DRAFTING_TEMPERATURE=0.7
DRAFTING_NUM_CTX=8192

# --- Hiperparâmetros: Fase 2 ---
REFINING_TEMPERATURE=0.75
REFINING_NUM_CTX=8192

# --- Hiperparâmetros: Fase 3 ---
SUMMARIZING_TEMPERATURE=0.3
SUMMARIZING_NUM_CTX=4096

# --- Timeout (segundos) ---
# Valor generoso para acomodar troca de modelo na VRAM
REQUEST_TIMEOUT=600
